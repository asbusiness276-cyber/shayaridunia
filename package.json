{
  "name": "shayari-dunia-vercel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "node --require ./scripts/node-memory-shim.cjs ./node_modules/next/dist/bin/next dev",
    "build": "node --require ./scripts/node-memory-shim.cjs ./node_modules/next/dist/bin/next build",
    "start": "node --require ./scripts/node-memory-shim.cjs ./node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test:content": "node --test tests/content.test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "verify": "npm run lint && npm run test:content && npm run security:audit && npm run build && npm run typecheck && npm run test:smoke"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
